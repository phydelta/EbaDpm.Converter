<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EbaDpm.Converter.Core</RootNamespace>
    <!-- Windows-only, x64 or x86 (AnyCPU; the bitness comes from the runtime identifier):
         reading the source depends on ACE OLEDB (16.0 or 12.0) -->

    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EbaDpm.Converter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\dpm-distribution-schema.sql">
      <LogicalName>EbaDpm.Converter.Core.Resources.dpm-distribution-schema.sql</LogicalName>
    </EmbeddedResource>
    <!-- Closed census of the known plane C divergences: regenerated per release,
         never hardcoded in C#. -->
    <EmbeddedResource Include="Resources\plane-c-known-divergences-4.2.tsv">
      <LogicalName>EbaDpm.Converter.Core.Resources.plane-c-known-divergences-4.2.tsv</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
