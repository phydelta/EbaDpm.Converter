<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EbaDpm.Converter.Core</RootNamespace>
    <!-- Windows-only, x64 or x86 (AnyCPU; the bitness comes from the runtime identifier):
         reading the source depends on ACE OLEDB (16.0 or 12.0) -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <!-- Shared project: it never references the distribution (45-table) pipeline nor the native one. -->
  <ItemGroup>
    <InternalsVisibleTo Include="EbaDpm.Converter.Distribution" />
    <InternalsVisibleTo Include="EbaDpm.Converter.Native" />
    <InternalsVisibleTo Include="EbaDpm.Converter" />
    <InternalsVisibleTo Include="EbaDpm.Converter.Core.Tests" />
    <InternalsVisibleTo Include="EbaDpm.Converter.Distribution.Tests" />
    <InternalsVisibleTo Include="EbaDpm.Converter.Native.Tests" />
    <InternalsVisibleTo Include="EbaDpm.Converter.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="System.Data.OleDb" Version="11.0.0" />
  </ItemGroup>

</Project>
