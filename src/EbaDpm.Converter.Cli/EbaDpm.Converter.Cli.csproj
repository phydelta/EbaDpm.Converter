<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>EbaDpm.Converter.Cli</RootNamespace>
    <AssemblyName>EbaDpm.Converter</AssemblyName>
    <!-- Windows-only, x64 or x86 (depends on ACE OLEDB 16.0 or 12.0). No PlatformTarget: plain
         build is a 64-bit process on x64 Windows; "publish -r win-x86" yields a 32-bit one. -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EbaDpm.Converter.Core\EbaDpm.Converter.Core.csproj" />
  </ItemGroup>

</Project>
