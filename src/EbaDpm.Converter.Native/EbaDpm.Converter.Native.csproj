<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>EbaDpm.Converter.Native</RootNamespace>
    <!-- Windows-only, x64 or x86 (depends on ACE OLEDB 16.0 or 12.0 through the shared project). -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <!-- The native DPM 2.0 pipeline: references ONLY the shared project, never the distribution one. -->
  <ItemGroup>
    <ProjectReference Include="..\EbaDpm.Converter.Core\EbaDpm.Converter.Core.csproj" />
  </ItemGroup>

  <!-- The catalogue of the 4.4 Access database: the baseline of the native output. -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\native-baseline-4.4.json">
      <LogicalName>EbaDpm.Converter.Native.Resources.native-baseline-4.4.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Plane C census of known divergences: one file per release (none yet: an empty census exempts nothing). -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\native-plane-c-known-divergences-*.tsv">
      <LogicalName>EbaDpm.Converter.Native.Resources.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EbaDpm.Converter" />
    <InternalsVisibleTo Include="EbaDpm.Converter.Native.Tests" />
  </ItemGroup>

</Project>
