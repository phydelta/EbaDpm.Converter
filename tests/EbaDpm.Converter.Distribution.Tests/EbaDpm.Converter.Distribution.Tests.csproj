<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <PlatformTarget>x64</PlatformTarget>
    <!-- Production code under test is marked [SupportedOSPlatform("windows")] -->
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.1.1" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="EbaDpm.Converter.Testing" />
    <Using Include="EbaDpm.Converter.Distribution.Access" />
    <Using Include="EbaDpm.Converter.Distribution.Sqlite" />
    <Using Include="EbaDpm.Converter.Distribution.Validation" />
    <Using Include="EbaDpm.Converter.Distribution.Validation.PlaneC" />
    <Using Include="EbaDpm.Converter.Distribution.Layouts" />
    <Using Include="EbaDpm.Converter.Core.Access" />
    <Using Include="EbaDpm.Converter.Core.Sqlite" />
    <Using Include="EbaDpm.Converter.Core.Validation" />
    <Using Include="EbaDpm.Converter.Core.Validation.PlaneC" />
    <Using Include="EbaDpm.Converter.Core.Layouts" />
    <Using Include="EbaDpm.Converter.Core.Layouts.Xlsx" />
  </ItemGroup>

  <ItemGroup>
    <!-- Test collections run serially (parallelizeTestCollections=false in xunit.runner.json): the
         Microsoft.ACE.OLEDB.16.0 provider is not safe for concurrent use within one process, and
         several fixtures keep an Access connection open while the tests run. -->
    <None Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\EbaDpm.Converter.Core\EbaDpm.Converter.Core.csproj" />
    <ProjectReference Include="..\..\src\EbaDpm.Converter.Distribution\EbaDpm.Converter.Distribution.csproj" />
    <ProjectReference Include="..\..\src\EbaDpm.Converter.Cli\EbaDpm.Converter.Cli.csproj" />
    <ProjectReference Include="..\EbaDpm.Converter.Testing\EbaDpm.Converter.Testing.csproj" />
  </ItemGroup>

</Project>
