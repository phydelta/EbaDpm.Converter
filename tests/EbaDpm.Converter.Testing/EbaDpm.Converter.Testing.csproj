<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared test infrastructure (data/ACE skip attributes, repository paths, fabricated Access and
       xlsx builders). It references no production project, so every test project can use it. -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- A library of helpers, not a test project (the xunit packages would otherwise mark it as one). -->
    <IsTestProject>false</IsTestProject>
    <PlatformTarget>x64</PlatformTarget>
    <SupportedOSPlatform>windows</SupportedOSPlatform>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="11.0.0" />
    <PackageReference Include="System.Data.OleDb" Version="11.0.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
